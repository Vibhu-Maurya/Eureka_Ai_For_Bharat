# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=YOUR_AWS_ACCOUNT_ID

# API Configuration
API_ENDPOINT=YOUR_API_GATEWAY_ENDPOINT_HERE
API_KEY=YOUR_API_KEY_HERE

# S3 Buckets
UPLOADS_BUCKET=orchestrai-uploads
CONTENT_BUCKET=orchestrai-content

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Step Functions
STATE_MACHINE_ARN=YOUR_STATE_MACHINE_ARN_HERE

# Lambda Functions
VIDEO_ASSEMBLER_FUNCTION=YOUR_VIDEO_ASSEMBLER_FUNCTION_NAME

# FFmpeg Layer
FFMPEG_LAYER_ARN=YOUR_FFMPEG_LAYER_ARN

# Public Interface
PUBLIC_INTERFACE_URL=YOUR_S3_WEBSITE_URL
